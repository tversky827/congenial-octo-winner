# Copy this file to `.env` and fill in real values before running the app.

# --- Database ---
# SQLite (default, zero-config, great for getting started / single-server internal use):
DATABASE_URL="file:./dev.db"
# Postgres (recommended for production / multi-instance hosting like Vercel):
# DATABASE_URL="postgresql://user:password@host:5432/shiftboard?schema=public"

# --- Auth ---
# Secret used to sign login session tokens. MUST be a long random string in production.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Invite code required to create a MANAGER account during sign-up.
# Give this only to people who should be able to post & approve shifts.
MANAGER_INVITE_CODE="goldwater-managers"

# --- App ---
# Public base URL of the deployed app (used for links). Optional in development.
NEXT_PUBLIC_APP_NAME="ShiftBoard"

# --- Paycor integration (optional) ---
# From the Paycor Developer Portal. When all four are set, Admin -> Integrations
# can sync employees (Location -> facility, Job Title -> CNA/Nurse, pay rate ->
# marketplace rate). Never commit real values; set them in your host's env vars.
# PAYCOR_CLIENT_ID=""
# PAYCOR_CLIENT_SECRET=""
# PAYCOR_SUBSCRIPTION_KEY=""       # Ocp-Apim-Subscription-Key from the portal
# PAYCOR_TENANT_ID=""              # your Paycor legal-entity / tenant id
# Optional overrides (sensible defaults target apis.paycor.com):
# PAYCOR_BASE_URL="https://apis.paycor.com"
# PAYCOR_TOKEN_URL="https://apis.paycor.com/sts/v1/common/token"
# PAYCOR_SCOPE=""

# Secret guarding the scheduled (Vercel Cron) auto-sync endpoint. Set to a long
# random string; the cron calls the endpoint with `Authorization: Bearer <this>`.
# CRON_SECRET=""

# --- Email notifications (optional) ---
# When both are set, notifications also send by email via Resend
# (https://resend.com). Until then, email is a silent no-op; in-app
# notifications always work. Verify your sending domain in Resend first.
# RESEND_API_KEY=""
# EMAIL_FROM="Goldwater Care <no-reply@yourdomain.com>"
# Absolute base URL so email links open the app (e.g. https://app.yourdomain.com).
# APP_URL=""

# --- SMS notifications (optional, opt-in) ---
# When all three are set, opted-in nurses with a mobile number also get texts
# via Twilio. No-op until configured; in-app always works.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+15551234567"   # your Twilio sending number (E.164)
