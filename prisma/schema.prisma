// ShiftBoard data model.
// Using SQLite by default for zero-config local/internal use. To move to Postgres,
// change `provider` to "postgresql" and set DATABASE_URL accordingly (see .env.example).
//
// Note: SQLite doesn't support native enums, so status/role fields are stored as
// strings. Their allowed values are enforced in the application layer (see
// src/lib/validation.ts and the route handlers):
//   Role         : "CORPORATE" | "MANAGER" | "WORKER"
//   ShiftStatus  : "PLANNED" | "ASSIGNED" | "OPEN" | "FILLED" | "COMPLETED" | "CANCELLED"
//   ClaimStatus  : "PENDING" | "APPROVED" | "REJECTED" | "WITHDRAWN"
//
// Shift lifecycle (scheduling-first):
//   PLANNED  — built from the facility's staffing template into a draft week
//   ASSIGNED — the scheduler placed one of our employees on it
//   OPEN     — the week was published and this shift was still empty, so it went
//              to the marketplace for staff to claim
//   FILLED   — an OPEN shift was claimed and approved
//   CANCELLED / COMPLETED — as before
//
// Multi-facility model:
//   - CORPORATE users oversee every facility (facilityId is null).
//   - MANAGER (facility scheduler) and WORKER users belong to exactly one
//     facility (facilityId set). This is enforced in the app, so the column is
//     nullable at the DB level to keep migrations non-destructive.
//   - Every Shift belongs to a facility (again enforced in the app).

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev; the rhel target is what Vercel's serverless
  // runtime needs so the query engine loads in production.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The tenant boundary — one customer (a company that may own many SNFs). Every
// facility, user, and downstream record belongs to exactly one organization, and
// data is isolated by it. `organizationId` is nullable during the additive
// migration and backfilled into a default org so the live app keeps working.
model Organization {
  id        String   @id @default(cuid())
  name      String
  // URL-friendly handle, e.g. "goldwater-care".
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  facilities  Facility[]
  users       User[]
  auditLogs   AuditLog[]
  departments Department[]
  positions   Position[]
}

// A department within an organization (Nursing, Dietary, Housekeeping…).
model Department {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  positions Position[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// A configurable job position (CNA, RN, LPN, Dietary Aide…). Positions are
// per-organization data, not a hard-coded enum, so every facility can differ.
// Shifts and employees still carry the position *name* (denormalized) so the
// scheduling/marketplace code is unchanged; names are validated against this list.
model Position {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  name           String
  // Requires a professional license — used later by the credential/eligibility engine.
  licensed       Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Facility {
  id             String  @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  // Optional address / description shown to staff.
  address        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  users          User[]
  shifts         Shift[]
  templateShifts TemplateShift[]
  schedules      Schedule[]

  @@index([organizationId])
}

// A facility's DAILY staffing budget — the coverage the corporate admin sets,
// applied to every day of the week. Each row means: this facility needs `count`
// shifts of `position` from `startTime`–`endTime` every day. Building a week
// generates these into PLANNED shifts for all 7 days.
// (dayOfWeek is retained but unused — the template is now daily.)
model TemplateShift {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  position   String // CNA | Nurse
  dayOfWeek  Int      @default(0) // unused (template is daily)
  startTime  String // "07:00"
  endTime    String // "15:00"
  count      Int      @default(1)
  bonus      Float    @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([facilityId])
}

// One facility's schedule for one week. Holds the publish state.
model Schedule {
  id          String    @id @default(cuid())
  facilityId  String
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  weekStart   DateTime // Monday 00:00 UTC of the week
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  shifts Shift[]

  @@unique([facilityId, weekStart])
}

model User {
  id             String  @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  email          String  @unique
  passwordHash   String
  name           String
  role           String  @default("WORKER")
  // The facility this person belongs to. Null for CORPORATE (sees all).
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id])
  // Position/title, e.g. "RN", "CNA", "Caregiver". Used to match shifts to staff.
  position     String?
  // Default hourly pay. A shift can override this, but it's a sensible fallback.
  baseRate     Float    @default(0)
  phone        String?
  // --- Employment profile (HR-facing, optional) ---
  // External HR/payroll identifier for this person.
  employeeId   String?
  // FULL_TIME | PART_TIME | PER_DIEM — drives scheduling & benefits rules later.
  employmentType String? @default("PER_DIEM")
  hireDate     DateTime?
  // Free-form internal notes visible only to schedulers/admins.
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  postedShifts    Shift[]        @relation("PostedBy")
  assignedShifts  Shift[]        @relation("AssignedShifts")
  claims          Claim[]
  callOffs        CallOff[]      @relation("CallOffs")
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([facilityId])
  @@index([organizationId])
}

model Shift {
  id           String   @id @default(cuid())
  title        String
  position     String // role required, e.g. "CNA"
  // The facility this shift belongs to (which board it shows on).
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id])
  // Optional finer location within the facility, e.g. "2nd Floor / Unit B".
  location     String?
  startTime    DateTime
  endTime      DateTime
  // Unpaid break in minutes, subtracted from paid hours.
  breakMinutes Int      @default(0)
  // Flat pick-up bonus added to the shift's pay (on top of the employee's
  // hourly rate × hours). Optional incentive to fill a shift.
  bonus        Float    @default(0)
  // --- Legacy columns, retained so existing rows stay valid but no longer used
  // in pay (pay = employee rate × hours + bonus; no differential, break, or OT).
  hourlyRate   Float    @default(0)
  differential Float    @default(0)
  overtimeAfterHours Float @default(8)
  overtimeMultiplier Float @default(1.5)
  notes        String?
  status       String   @default("OPEN")

  postedById String
  postedBy   User   @relation("PostedBy", fields: [postedById], references: [id])

  // The week/schedule this shift belongs to (null for ad-hoc marketplace shifts).
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  // The employee placed on this shift — set by the scheduler (ASSIGNED) or by an
  // approved marketplace claim (FILLED).
  assignedToId String?
  assignedTo   User?   @relation("AssignedShifts", fields: [assignedToId], references: [id])

  claims   Claim[]
  callOffs CallOff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId, status, startTime])
  @@index([scheduleId])
  @@index([assignedToId])
}

// A record of an employee (or a scheduler on their behalf) calling off a shift
// they were assigned to. Kept for attendance/reliability reporting; reopening
// the shift to the marketplace is a separate effect handled in the route.
model CallOff {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  workerId  String
  worker    User     @relation("CallOffs", fields: [workerId], references: [id], onDelete: Cascade)
  // Who recorded it (the worker themselves, or a scheduler/admin).
  recordedById String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([workerId])
}

model Claim {
  id        String    @id @default(cuid())
  shiftId   String
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  workerId  String
  worker    User      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  status    String    @default("PENDING")
  message   String? // optional note from the worker when claiming
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  // A worker can only have one claim per shift.
  @@unique([shiftId, workerId])
  @@index([shiftId, status])
}

model Notification {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  body   String
  // In-app link the notification points to, e.g. "/shifts/abc123".
  link   String?
  read   Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Immutable record of every consequential action. Append-only in practice —
// the app never updates or deletes rows here.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  // Who did it (nullable for system actions).
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id])
  actorName      String? // denormalized so the log survives user deletion
  action         String // e.g. "shift.assign", "schedule.publish", "user.role_change"
  entityType     String? // "Shift", "Schedule", "User"…
  entityId       String?
  // JSON snapshots of the change (stringified) for before/after diffing.
  before         String?
  after          String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}
