// ShiftBoard data model.
// Using SQLite by default for zero-config local/internal use. To move to Postgres,
// change `provider` to "postgresql" and set DATABASE_URL accordingly (see .env.example).
//
// Note: SQLite doesn't support native enums, so status/role fields are stored as
// strings. Their allowed values are enforced in the application layer (see
// src/lib/validation.ts and the route handlers):
//   Role         : "CORPORATE" | "MANAGER" | "WORKER"
//   ShiftStatus  : "PLANNED" | "ASSIGNED" | "OPEN" | "FILLED" | "COMPLETED" | "CANCELLED"
//   ClaimStatus  : "PENDING" | "APPROVED" | "REJECTED" | "WITHDRAWN"
//
// Shift lifecycle (scheduling-first):
//   PLANNED  — built from the facility's staffing template into a draft week
//   ASSIGNED — the scheduler placed one of our employees on it
//   OPEN     — the week was published and this shift was still empty, so it went
//              to the marketplace for staff to claim
//   FILLED   — an OPEN shift was claimed and approved
//   CANCELLED / COMPLETED — as before
//
// Multi-facility model:
//   - CORPORATE users oversee every facility (facilityId is null).
//   - MANAGER (facility scheduler) and WORKER users belong to exactly one
//     facility (facilityId set). This is enforced in the app, so the column is
//     nullable at the DB level to keep migrations non-destructive.
//   - Every Shift belongs to a facility (again enforced in the app).

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev; the rhel target is what Vercel's serverless
  // runtime needs so the query engine loads in production.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The tenant boundary — one customer (a company that may own many SNFs). Every
// facility, user, and downstream record belongs to exactly one organization, and
// data is isolated by it. `organizationId` is nullable during the additive
// migration and backfilled into a default org so the live app keeps working.
model Organization {
  id        String   @id @default(cuid())
  name      String
  // URL-friendly handle, e.g. "goldwater-care".
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  facilities  Facility[]
  users       User[]
  auditLogs   AuditLog[]
  departments Department[]
  positions   Position[]
  agencies    Agency[]
}

// A staffing agency partner the org uses to fill shifts in-house staff can't.
// Agency labor is billed at billRate/hour (typically higher than employee pay).
model Agency {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  billRate       Float    @default(0) // $/hour billed for agency staff
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  shifts Shift[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// A department within an organization (Nursing, Dietary, Housekeeping…).
model Department {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  positions Position[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// A configurable job position (CNA, RN, LPN, Dietary Aide…). Positions are
// per-organization data, not a hard-coded enum, so every facility can differ.
// Shifts and employees still carry the position *name* (denormalized) so the
// scheduling/marketplace code is unchanged; names are validated against this list.
model Position {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  name           String
  // Requires a professional license — used by the credential/eligibility engine.
  licensed       Boolean  @default(false)
  // If set, a worker must hold a valid (non-expired) credential of this type to
  // be eligible for this position's shifts, e.g. "RN License".
  requiredCredential String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Facility {
  id             String  @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  // Optional address / description shown to staff.
  address        String?
  city           String?
  state          String?
  zip            String?
  phone          String?
  timezone       String?  @default("America/Chicago")
  // --- Accounting (cost center) ---
  // Where this facility's Nurse Pool labor is allocated for accounting exports.
  costCenterCode       String?
  glAccount            String?
  payrollAllocationCode String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  users          User[]
  shifts         Shift[]
  templateShifts TemplateShift[]
  schedules      Schedule[]
  eligibilities    NurseFacilityEligibility[]
  shiftAssignments ShiftAssignment[]
  costAllocations  LaborCostAllocation[]

  @@index([organizationId])
}

// A facility's DAILY staffing budget — the coverage the corporate admin sets,
// applied to every day of the week. Each row means: this facility needs `count`
// shifts of `position` from `startTime`–`endTime` every day. Building a week
// generates these into PLANNED shifts for all 7 days.
// (dayOfWeek is retained but unused — the template is now daily.)
model TemplateShift {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  position   String // CNA | Nurse
  dayOfWeek  Int      @default(0) // unused (template is daily)
  startTime  String // "07:00"
  endTime    String // "15:00"
  count      Int      @default(1)
  bonus      Float    @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([facilityId])
}

// One facility's schedule for one week. Holds the publish state.
model Schedule {
  id          String    @id @default(cuid())
  facilityId  String
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  weekStart   DateTime // Monday 00:00 UTC of the week
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  shifts Shift[]

  @@unique([facilityId, weekStart])
}

model User {
  id             String  @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  email          String  @unique
  passwordHash   String
  name           String
  role           String  @default("WORKER")
  // The facility this person belongs to. Null for CORPORATE (sees all).
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id])
  // Position/title, e.g. "RN", "CNA", "Caregiver". Used to match shifts to staff.
  position     String?
  // Default hourly pay. A shift can override this, but it's a sensible fallback.
  baseRate     Float    @default(0)
  phone        String?
  // --- Employment profile (HR-facing, optional) ---
  // External HR/payroll identifier for this person (e.g. Paycor employee number).
  employeeId   String?
  // Source system this record was synced from, e.g. "paycor" (null = created in-app).
  source       String?
  // FULL_TIME | PART_TIME | PER_DIEM — drives scheduling & benefits rules later.
  employmentType String? @default("PER_DIEM")
  hireDate     DateTime?
  // Free-form internal notes visible only to schedulers/admins.
  notes        String?
  // True for accounts created by an import (Paycor) that haven't set a password
  // yet — they can be scheduled immediately, and claim login by registering
  // with their work email.
  mustSetPassword Boolean @default(false)
  // --- Nurse Pool ---
  // A pool nurse's PAYROLL HOME is the centralized Nurse Pool, not a facility:
  // poolMember=true and facilityId stays null. Where they may work is governed
  // by NurseFacilityEligibility, not by an employer facility.
  poolMember     Boolean @default(false)
  licenseType    String? // e.g. "RN", "LPN"
  licenseNumber  String?
  licenseExpiry  DateTime?
  // Per-nurse overtime multiplier override (falls back to org SystemSetting).
  overtimeMultiplier Float?
  // --- Shift-matching preferences (pool nurse) ---
  prefMinRate    Float?   // only notify about shifts paying at least this
  prefFacilityIds String? // JSON array of preferred facility ids ("[]"/null = any)
  prefDaysOfWeek String?  // JSON array of weekdays 0=Sun..6=Sat (null = any)
  notifyEmail    Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  postedShifts    Shift[]        @relation("PostedBy")
  assignedShifts  Shift[]        @relation("AssignedShifts")
  claims          Claim[]
  callOffs        CallOff[]      @relation("CallOffs")
  timeEntries     TimeEntry[]    @relation("TimeEntries")
  credentials     Credential[]   @relation("Credentials")
  notifications   Notification[]
  auditLogs       AuditLog[]
  // Pool relations
  eligibilities   NurseFacilityEligibility[]
  shiftAssignments ShiftAssignment[]
  payrollRecords  PayrollRecord[]
  costAllocations LaborCostAllocation[]

  @@index([facilityId])
  @@index([organizationId])
  @@index([poolMember])
}

model Shift {
  id           String   @id @default(cuid())
  title        String
  position     String // role required, e.g. "CNA"
  // The facility this shift belongs to (which board it shows on).
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id])
  // Optional finer location within the facility, e.g. "2nd Floor / Unit B".
  location     String?
  startTime    DateTime
  endTime      DateTime
  // Unpaid break in minutes, subtracted from paid hours.
  breakMinutes Int      @default(0)
  // Flat pick-up bonus added to the shift's pay (on top of the employee's
  // hourly rate × hours). Optional incentive to fill a shift.
  bonus        Float    @default(0)
  // --- Legacy columns, retained so existing rows stay valid but no longer used
  // in pay (pay = employee rate × hours + bonus; no differential, break, or OT).
  hourlyRate   Float    @default(0)
  differential Float    @default(0)
  overtimeAfterHours Float @default(8)
  overtimeMultiplier Float @default(1.5)
  notes        String?
  status       String   @default("OPEN")
  // How many nurses this shift needs. Pool shifts can need several; each seat is
  // one ShiftAssignment. The shift is FILLED when seatsFilled == nursesNeeded.
  nursesNeeded Int      @default(1)
  // Atomic seat counter — a conditional increment (seatsFilled < nursesNeeded)
  // is how two nurses can take two seats but never the same last seat.
  seatsFilled  Int      @default(0)
  // Required license for a pool shift, e.g. "RN" (null = any matching position).
  requiredLicense String?
  // Per-hour shift differential for pool pay (separate from the flat `bonus`).
  differentialPerHour Float @default(0)

  postedById String
  postedBy   User   @relation("PostedBy", fields: [postedById], references: [id])

  // The week/schedule this shift belongs to (null for ad-hoc marketplace shifts).
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  // The employee placed on this shift — set by the scheduler (ASSIGNED) or by an
  // approved marketplace claim (FILLED).
  assignedToId String?
  assignedTo   User?   @relation("AssignedShifts", fields: [assignedToId], references: [id])

  // Alternatively, an open shift can be filled by a staffing agency instead of
  // an employee. When set, assignedToId is null and the labor is billed at the
  // agency's rate.
  agencyId        String?
  agency          Agency? @relation(fields: [agencyId], references: [id])
  agencyWorkerName String?

  claims    Claim[]
  callOffs  CallOff[]
  timeEntries TimeEntry[]
  assignments ShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId, status, startTime])
  @@index([scheduleId])
  @@index([assignedToId])
}

// A record of an employee (or a scheduler on their behalf) calling off a shift
// they were assigned to. Kept for attendance/reliability reporting; reopening
// the shift to the marketplace is a separate effect handled in the route.
model CallOff {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  workerId  String
  worker    User     @relation("CallOffs", fields: [workerId], references: [id], onDelete: Cascade)
  // Who recorded it (the worker themselves, or a scheduler/admin).
  recordedById String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([workerId])
}

model Claim {
  id        String    @id @default(cuid())
  shiftId   String
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  workerId  String
  worker    User      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  status    String    @default("PENDING")
  message   String? // optional note from the worker when claiming
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  // A worker can only have one claim per shift.
  @@unique([shiftId, workerId])
  @@index([shiftId, status])
}

// A time-clock punch pair for one shift: when the employee actually clocked in
// and out. `actualMinutes` is the worked span (set at clock-out). This is the
// "Actual" the coverage/labor engines compare against the scheduled plan.
model TimeEntry {
  id           String    @id @default(cuid())
  shiftId      String
  shift        Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  workerId     String
  worker       User      @relation("TimeEntries", fields: [workerId], references: [id], onDelete: Cascade)
  facilityId   String?
  // The pool shift seat this punch belongs to (null for legacy facility shifts).
  assignmentId String?   @unique
  assignment   ShiftAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  clockInAt    DateTime  @default(now())
  clockOutAt   DateTime?
  actualMinutes Int?     // computed at clock-out
  // Present once payroll math has run for this entry (hours × rate + bonus).
  actualPay    Float?
  createdAt    DateTime  @default(now())

  // One open/closed punch pair per worker per shift.
  @@unique([shiftId, workerId])
  @@index([workerId])
  @@index([facilityId])
}

// A license or certification held by an employee, with an optional expiration.
// The compliance engine flags expired/expiring credentials and the eligibility
// engine can require a valid one for licensed positions.
model Credential {
  id         String    @id @default(cuid())
  workerId   String
  worker     User      @relation("Credentials", fields: [workerId], references: [id], onDelete: Cascade)
  // The credential type, e.g. "RN License", "BLS/CPR", "TB Test".
  type       String
  number     String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([workerId])
}

model Notification {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  body   String
  // In-app link the notification points to, e.g. "/shifts/abc123".
  link   String?
  read   Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Immutable record of every consequential action. Append-only in practice —
// the app never updates or deletes rows here.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  // Who did it (nullable for system actions).
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id])
  actorName      String? // denormalized so the log survives user deletion
  action         String // e.g. "shift.assign", "schedule.publish", "user.role_change"
  entityType     String? // "Shift", "Schedule", "User"…
  entityId       String?
  // JSON snapshots of the change (stringified) for before/after diffing.
  before         String?
  after          String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

// =====================================================================
// Nurse Pool — float-pool model. A nurse's PAYROLL HOME is the pool; the
// labor EXPENSE is allocated to the facility where each shift was worked.
// =====================================================================

// Where a pool nurse is permitted to work. Separate from employment — a nurse
// can be eligible at many facilities without any of them being their employer.
model NurseFacilityEligibility {
  id         String   @id @default(cuid())
  nurseId    String
  nurse      User     @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  active     Boolean  @default(true)
  // Facility-specific onboarding gate for claiming shifts there.
  orientationComplete Boolean @default(false)
  createdAt  DateTime @default(now())

  @@unique([nurseId, facilityId])
  @@index([facilityId])
}

// One nurse's claim on ONE seat of a shift. The spine of the pool: work
// location, hours (scheduled/actual/approved), pay, and approval live here.
model ShiftAssignment {
  id             String   @id @default(cuid())
  shiftId        String
  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  nurseId        String
  nurse          User     @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  // Denormalized work location for fast facility-scoped queries & allocation.
  facilityId     String
  facility       Facility @relation(fields: [facilityId], references: [id])

  scheduledStart DateTime
  scheduledEnd   DateTime
  scheduledHours Float
  payRate        Float    // the nurse's rate captured at claim time
  differentialPerHour Float @default(0)

  // CLAIMED → CHECKED_IN → WORKED → PENDING_APPROVAL → APPROVED / CANCELLED / DISPUTED
  status         String   @default("CLAIMED")
  claimedAt      DateTime @default(now())
  checkInAt      DateTime?
  checkOutAt     DateTime?
  actualHours    Float?

  // Facility approval of payable hours (authoritative for payroll).
  approvedHours  Float?
  regularHours   Float?
  overtimeHours  Float?
  grossPay       Float?
  approvalStatus String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedById   String?
  approvedAt     DateTime?

  // Cancellation trail (claimed shifts are never deleted).
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?

  timeEntry      TimeEntry?
  payrollRecordId String?
  payrollRecord  PayrollRecord? @relation(fields: [payrollRecordId], references: [id])
  allocation     LaborCostAllocation?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // A nurse holds at most one assignment per shift.
  @@unique([shiftId, nurseId])
  @@index([nurseId, status])
  @@index([facilityId, status])
  @@index([shiftId])
}

// A pay window (default weekly Mon–Sun).
model PayrollPeriod {
  id             String   @id @default(cuid())
  organizationId String
  startDate      DateTime
  endDate        DateTime
  // OPEN → PROCESSING → PENDING_APPROVAL → APPROVED → EXPORTED → CLOSED
  status         String   @default("OPEN")
  finalizedAt    DateTime?
  finalizedById  String?
  createdAt      DateTime @default(now())

  records        PayrollRecord[]
  allocations    LaborCostAllocation[]

  @@unique([organizationId, startDate, endDate])
  @@index([organizationId, status])
}

// Per nurse, per period — the Nurse Pool payroll record (payroll home = pool).
model PayrollRecord {
  id              String   @id @default(cuid())
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  nurseId         String
  nurse           User     @relation(fields: [nurseId], references: [id])
  regularHours    Float    @default(0)
  overtimeHours   Float    @default(0)
  regularPay      Float    @default(0)
  overtimePay     Float    @default(0)
  differentialPay Float    @default(0)
  grossPay        Float    @default(0)
  createdAt       DateTime @default(now())

  assignments     ShiftAssignment[]

  @@unique([payrollPeriodId, nurseId])
  @@index([nurseId])
}

// Immutable ledger: one row per approved assignment, allocating its labor cost
// to the FACILITY where the shift was worked. Never silently modified once a
// period is finalized — corrections create adjustment rows.
model LaborCostAllocation {
  id              String   @id @default(cuid())
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  nurseId         String
  nurse           User     @relation(fields: [nurseId], references: [id])
  assignmentId    String   @unique
  assignment      ShiftAssignment @relation(fields: [assignmentId], references: [id])
  facilityId      String
  facility        Facility @relation(fields: [facilityId], references: [id])
  costCenter      String?

  regularHours    Float    @default(0)
  overtimeHours   Float    @default(0)
  regularPay      Float    @default(0)
  overtimePay     Float    @default(0)
  differentialPay Float    @default(0)
  totalAllocated  Float    @default(0)

  // POSTED | ADJUSTMENT | REVERSED — adjustments reference the original.
  entryType       String   @default("POSTED")
  adjustsId       String?
  status          String   @default("ALLOCATED") // ALLOCATED | EXPORTED
  accountingExportId String?
  createdAt       DateTime @default(now())
  exportedAt      DateTime?

  @@index([payrollPeriodId])
  @@index([facilityId])
  @@index([nurseId])
}

// A generated accounting export batch (CSV today; integrations later).
model AccountingExport {
  id             String   @id @default(cuid())
  organizationId String
  payrollPeriodId String?
  format         String   @default("csv")
  rowCount       Int      @default(0)
  totalAmount    Float    @default(0)
  status         String   @default("GENERATED")
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// Per-org configurable business rules (OT thresholds, rest period, max hours,
// cancellation window…). Stored as key → JSON value so new rules need no schema
// change. The app reads these with sensible defaults when a key is unset.
model SystemSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          String   // JSON-encoded
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
}
